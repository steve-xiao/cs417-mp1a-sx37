--- !u!114 &686325087
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 686325085}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "XR TRACKED CAMERA \u2014 headset movement controls camera position and
    view\r\nWORLD SPACE \u2014 Instructions Canvas stays fixed in the 3D world\r\nOBJECT
    SPACE \u2014 Moon is child of Planet and moves with it\r\nMATERIALS \u2014 custom
    materials used throughout the scene\r\nHIGHLIGHT OUTLINE \u2014 Planet uses custom
    outline vertex shader\r\nOBJECT CONTENT \u2014 16+ decorative objects in the
    room\r\nMATERIAL CONTENT \u2014 13 distinct materials on distinct objects\r\n\r\nEULER
    STEADY \u2014 Moon movement uses Time.deltaTime\r\nKINEMATIC DOUBLE INTEGRATOR
    \u2014 acceleration updates velocity, velocity updates position\r\nARBITRARY
    ORBITER \u2014 comet is pulled toward Planet\u2019s world position\r\n\r\nXR
    CONTROLLER INPUTS \u2014 controller buttons trigger scripts\r\nRAINBOW LIGHTING
    \u2014 Left Primary changes Point Light color\r\nOBJECT SPAWNING \u2014 Right
    Trigger spawns projectile\r\nOBJECT SHOOTER \u2014 spawned projectile uses controller-directed
    velocity\r\nPERFECT ORBITS \u2014 orbital speed = sqrt(gravity / distance)\r\n\r\nPARTICLE
    BURSTS \u2014 shooting creates particles at projectile spawn\r\nPARTICLE FEEDBACK
    CONTENT \u2014 16 emitters across Shoot, Light, Break Out, Return\r\nSPATIAL
    SOUND \u2014 shooting creates 3D sound at projectile spawn\r\nSPATIAL SOUND CONTENT
    \u2014 16 spatial AudioSources across 4 feedback groups\r\n\r\nCAMERA TELEPORT
    \u2014 Left Trigger moves player outside\r\nSKYBOX MATERIAL \u2014 custom skybox
    visible outside\r\nRETURN \u2014 Left Trigger again returns player to room\r\nQUIT
    KEY \u2014 Right Grip exits application; DO LAST"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
