  m_GameObject: {fileID: 686325085}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "XR TRACKED CAMERA \u2014 physical head movement controls camera position/view\r\nWORLD
    SPACE \u2014 Instructions Canvas stays fixed in the 3D world\r\nOBJECT SPACE
    \u2014 Moon is child of Planet; transforms move together\r\nMATERIALS \u2014
    custom materials applied throughout scene\r\nHIGHLIGHT OUTLINE \u2014 Planet
    uses custom outline vertex shader\r\nOBJECT CONTENT \u2014 16+ decorative object
    assets in room\r\nMATERIAL CONTENT \u2014 8+ distinct materials applied to distinct
    objects\r\nCUSTOM ROOM GEOMETRY \u2014 sloped/gabled roof created in Blender
    and imported into Unity\n\r\nEULER STEADY \u2014 Moon movement uses Time.deltaTime;
    frame-rate independent\r\nKINEMATIC DOUBLE INTEGRATOR \u2014 acceleration updates
    velocity; velocity updates position every frame\r\nARBITRARY ORBITER \u2014 comet
    acceleration pulls toward Planet\u2019s world position\r\nXR CONTROLLER INPUTS
    \u2014 controller buttons mapped to scripts using Input Actions\n\r\nRAINBOW
    LIGHTING \u2014 controller button changes Point Light color\r\nOBJECT SPAWNING
    \u2014 right trigger instantiates projectile prefab\r\nOBJECT SHOOTER \u2014
    projectile has internal velocity initialized from controller direction\r\nPARTICLE
    BURSTS \u2014 projectile spawn creates particle burst at same location\r\nSPATIAL
    SOUND \u2014 projectile spawn creates spatialized 3D sound at same location\r\nPERFECT
    ORBITS \u2014 radial velocity removed; stable speed = sqrt(gravity / distance)\r\nCAMERA
    TELEPORT \u2014 controller button teleports XR player/camera to external viewpoint\n\r\nSKYBOX
    MATERIAL \u2014 custom non-default skybox visible outside\r\nRETURN \u2014 same
    teleport button returns player to room\r\nQUIT KEY \u2014 controller input exits
    application; DO LAST \u2192 Quit"
